# ==============================================================================
# Coconea — Variables de Entorno de Ejemplo
# Presupuesto objetivo: $0 MXN (Solo desarrollo local y demo estática)
# ==============================================================================

# --- Base de Datos PostgreSQL Local (Docker Compose) ---
POSTGRES_USER=coconea_user
POSTGRES_PASSWORD=coconea_password
POSTGRES_DB=coconea_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://coconea_user:coconea_password@localhost:5432/coconea_dev

# --- API NestJS ---
PORT=4000
API_PORT=4000
API_PREFIX=v1
API_URL=http://localhost:4000/v1
NODE_ENV=development

# --- Autenticación (Better Auth) ---
BETTER_AUTH_SECRET=coconea_development_secret_key_min_32_characters_long
BETTER_AUTH_URL=http://localhost:4000

# --- Direcciones de Aplicaciones Web Frontend (Next.js) ---
CUSTOMER_WEB_URL=http://localhost:3000
RESTAURANT_WEB_URL=http://localhost:3001
DELIVERY_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003

# --- Simulación de Pagos (MVP $0 MXN) ---
# Usar exclusivamente 'mock'. No se utilizan cobros reales ni pasarelas comerciales.
PAYMENT_PROVIDER_MODE=mock
