{
  "name": "@coconea/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --path tsconfig.dev.json",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "echo \"@coconea/api: linting...\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@coconea/shared": "workspace:*",
    "@coconea/types": "workspace:*",
    "@coconea/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "better-auth": "1.7.14",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "^5.8.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  }
}
