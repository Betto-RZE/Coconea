'use client';

import React, { useState } from 'react';
import { PROJECT_NAME, PROJECT_MOTTO } from '@coconea/shared';
import { Sparkles, Calendar, Heart, ShieldCheck, Loader2, LogOut, User, ChefHat, Truck, Lock, Phone, MapPin } from 'lucide-react';
import CustomerDashboard from '@/app/components/CustomerDashboard';

export default function CustomerHome() {
  const [mostrarModalRegistro, setMostrarModalRegistro] = useState(false);
  const [mostrarModalLogin, setMostrarModalLogin] = useState(false);

  // Estado del usuario activo (para cuando es consumidor)
  const [usuarioActivo, setUsuarioActivo] = useState<{ nombre: string; email: string; rol: string } | null>(null);

  // Estados para Registro (incluyen teléfono y dirección)
  const [nombreReg, setNombreReg] = useState('');
  const [emailReg, setEmailReg] = useState('');
  const [passwordReg, setPasswordReg] = useState('');
  const [telefonoReg, setTelefonoReg] = useState('');
  const [direccionReg, setDireccionReg] = useState('');
  const [rolReg, setRolReg] = useState('CONSUMER');
  const [loadingReg, setLoadingReg] = useState(false);
  const [mensajeReg, setMensajeReg] = useState<{ texto: string; tipo: 'success' | 'error' } | null>(null);

  // Estados para Login
  const [emailLog, setEmailLog] = useState('');
  const [passwordLog, setPasswordLog] = useState('');
  const [loadingLog, setLoadingLog] = useState(false);
  const [mensajeLog, setMensajeLog] = useState<{ texto: string; tipo: 'success' | 'error' } | null>(null);

  const handleRegister = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!nombreReg || !emailReg || !passwordReg) {
      setMensajeReg({ texto: 'Por favor completa al menos los campos obligatorios', tipo: 'error' });
      return;
    }

    setLoadingReg(true);
    setMensajeReg(null);

    try {
      const response = await fetch('http://localhost:4000/v1/usuarios', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: nombreReg,
          email: emailReg,
          passwordHash: passwordReg,
          telefono: telefonoReg,
          direccion: direccionReg,
          rol: rolReg
        }),
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || 'Error al registrar en el servidor');
      }

      const data = await response.json();
      setMensajeReg({ texto: `¡${rolReg} registrado con éxito! ID: ${data.id}`, tipo: 'success' });
      setNombreReg('');
      setEmailReg('');
      setPasswordReg('');
      setTelefonoReg('');
      setDireccionReg('');
    } catch (error: any) {
      console.error(error);
      setMensajeReg({ texto: error.message || 'Error en el servidor o correo duplicado', tipo: 'error' });
    } finally {
      setLoadingReg(false);
    }
  };

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailLog || !passwordLog) {
      setMensajeLog({ texto: 'Por favor ingresa correo y contraseña', tipo: 'error' });
      return;
    }

    setLoadingLog(true);
    setMensajeLog(null);

    try {
      const response = await fetch('http://localhost:4000/v1/usuarios');
      if (!response.ok) throw new Error('No se pudo conectar con la base de datos');

      const usuarios = await response.json();
      const usuarioEncontrado = usuarios.find(
        (u: any) => u.email === emailLog && u.passwordHash === passwordLog
      );

      if (!usuarioEncontrado) {
        throw new Error('Correo o contraseña incorrectos en SQLite');
      }

      const rol = usuarioEncontrado.rol || 'CONSUMER';
      setMensajeLog({ texto: `¡Bienvenido, ${usuarioEncontrado.nombre}! Redirigiendo...`, tipo: 'success' });

      setTimeout(() => {
        switch (rol) {
          case 'RESTAURANT':
            window.location.href = 'http://localhost:3001';
            break;
          case 'DELIVERY':
            window.location.href = 'http://localhost:3002';
            break;
          case 'ADMIN':
            window.location.href = 'http://localhost:3003';
            break;
          case 'CONSUMER':
          default:
            setUsuarioActivo({
              nombre: usuarioEncontrado.nombre,
              email: usuarioEncontrado.email,
              rol: rol
            });
            setMostrarModalLogin(false);
            setMensajeLog(null);
            setEmailLog('');
            setPasswordLog('');
            break;
        }
      }, 1000);

    } catch (error: any) {
      console.error(error);
      setMensajeLog({ texto: error.message || 'Error al iniciar sesión', tipo: 'error' });
    } finally {
      setLoadingLog(false);
    }
  };

  const handleLogout = () => {
    setUsuarioActivo(null);
  };

  const handleConfirmProposal = async () => {
    try {
      const response = await fetch('http://localhost:4000/v1/pedidos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ estado: "PROGRAMADO", total: 165.50 }),
      });
      if (!response.ok) throw new Error('Error al crear pedido');
      const data = await response.json();
      alert(`¡Pedido confirmado y guardado! ID: ${data.id}`);
    } catch (error) {
      console.error(error);
      alert('Error al conectar con la API para guardar el pedido.');
    }
  };

  if (usuarioActivo) {
    return (
      <CustomerDashboard 
        nombre={usuarioActivo.nombre} 
        rol={usuarioActivo.rol} 
        onConfirmProposal={handleConfirmProposal} 
      />
    );
  }

  return (
    <div className="flex min-h-screen flex-col bg-white">
      <header className="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md">
        <div className="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
          <div className="flex items-center gap-2">
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-emerald-600 to-green-500 text-white font-bold text-xl shadow-sm">
              C
            </span>
            <span className="text-xl font-bold tracking-tight text-slate-900">{PROJECT_NAME}</span>
          </div>

          <div className="flex items-center gap-3">
            <button
              onClick={() => setMostrarModalLogin(true)}
              className="rounded-lg px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 transition"
            >
              Iniciar Sesión
            </button>
            <button
              onClick={() => setMostrarModalRegistro(true)}
              className="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 transition"
            >
              Registrarse
            </button>
          </div>
        </div>
      </header>

      <main className="flex-1">
        <section className="relative overflow-hidden bg-gradient-to-b from-emerald-50/60 via-white to-slate-50 py-16 sm:py-24">
          <div className="mx-auto max-w-6xl px-4 sm:px-6 text-center">
            <div className="inline-flex items-center gap-2 rounded-full bg-emerald-100/80 px-3.5 py-1 text-xs font-semibold text-emerald-800 mb-6 border border-emerald-200">
              <Sparkles className="h-3.5 w-3.5" />
              <span>Plataforma Modular Multi-Rol (Cliente, Restaurante, Delivery, Admin)</span>
            </div>
            <h1 className="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl md:text-6xl">
              Alimentación personalizada <br className="hidden sm:block" />
              <span className="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent">
                integrada con SQLite y NestJS
              </span>
            </h1>
            <p className="mx-auto mt-5 max-w-2xl text-lg text-slate-600">
              {PROJECT_MOTTO}
            </p>

            <div className="mt-8 flex flex-wrap items-center justify-center gap-4">
              <button
                onClick={() => setMostrarModalLogin(true)}
                className="rounded-xl bg-emerald-600 px-6 py-3.5 text-base font-semibold text-white shadow-md hover:bg-emerald-500 transition flex items-center gap-2"
              >
                <Calendar className="h-5 w-5" />
                Acceder al Sistema
              </button>
            </div>
          </div>
        </section>

        <section className="py-12 border-y border-slate-200/80 bg-white">
          <div className="mx-auto max-w-5xl px-4 sm:px-6">
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
              <div className="flex flex-col items-center text-center p-4 rounded-2xl border border-slate-100 bg-slate-50">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700 mb-3">
                  <User className="h-6 w-6" />
                </div>
                <h3 className="text-sm font-bold text-slate-900">Consumidor</h3>
                <p className="text-xs text-slate-500 mt-1">Planes nutricionales y confirmación de pedidos.</p>
              </div>

              <div className="flex flex-col items-center text-center p-4 rounded-2xl border border-slate-100 bg-slate-50">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-orange-700 mb-3">
                  <ChefHat className="h-6 w-6" />
                </div>
                <h3 className="text-sm font-bold text-slate-900">Restaurante</h3>
                <p className="text-xs text-slate-500 mt-1">Monitor de cocina y control de alérgenos.</p>
              </div>

              <div className="flex flex-col items-center text-center p-4 rounded-2xl border border-slate-100 bg-slate-50">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-blue-700 mb-3">
                  <Truck className="h-6 w-6" />
                </div>
                <h3 className="text-sm font-bold text-slate-900">Repartidor</h3>
                <p className="text-xs text-slate-500 mt-1">Gestión de rutas y entregas programadas.</p>
              </div>

              <div className="flex flex-col items-center text-center p-4 rounded-2xl border border-slate-100 bg-slate-50">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-100 text-purple-700 mb-3">
                  <Lock className="h-6 w-6" />
                </div>
                <h3 className="text-sm font-bold text-slate-900">Administrador</h3>
                <p className="text-xs text-slate-500 mt-1">Supervisión general de usuarios y base de datos.</p>
              </div>
            </div>
          </div>
        </section>
      </main>

      {/* Modal de Registro con Teléfono y Dirección */}
      {mostrarModalRegistro && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
          <div className="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
            <button 
              onClick={() => setMostrarModalRegistro(false)}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-700 font-bold"
            >
              ✕
            </button>
            <div className="text-center mb-4">
              <h3 className="text-lg font-bold text-slate-900">Registro General</h3>
              <p className="text-xs text-slate-500">Crea tu cuenta completando tus datos</p>
            </div>

            {mensajeReg && (
              <div className={`mb-3 p-2.5 rounded-xl text-xs font-medium ${mensajeReg.tipo === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200'}`}>
                {mensajeReg.texto}
              </div>
            )}

            <form onSubmit={handleRegister} className="space-y-3">
              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Tipo de Rol</label>
                <select
                  value={rolReg}
                  onChange={(e) => setRolReg(e.target.value)}
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none bg-white"
                >
                  <option value="CONSUMER">Cliente / Consumidor</option>
                  <option value="RESTAURANT">Restaurante</option>
                  <option value="DELIVERY">Repartidor</option>
                  <option value="ADMIN">Administrador</option>
                </select>
              </div>

              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Nombre Completo</label>
                <input
                  type="text"
                  value={nombreReg}
                  onChange={(e) => setNombreReg(e.target.value)}
                  placeholder="Tu nombre o negocio"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Correo Electrónico</label>
                <input
                  type="email"
                  value={emailReg}
                  onChange={(e) => setEmailReg(e.target.value)}
                  placeholder="correo@ejemplo.com"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Teléfono</label>
                <input
                  type="tel"
                  value={telefonoReg}
                  onChange={(e) => setTelefonoReg(e.target.value)}
                  placeholder="+52 222 123 4567"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Dirección</label>
                <input
                  type="text"
                  value={direccionReg}
                  onChange={(e) => setDireccionReg(e.target.value)}
                  placeholder="Calle, número, colonia"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>

              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Contraseña</label>
                <input
                  type="password"
                  value={passwordReg}
                  onChange={(e) => setPasswordReg(e.target.value)}
                  placeholder="••••••••"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>

              <button
                type="submit"
                disabled={loadingReg}
                className="w-full rounded-xl bg-emerald-600 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-emerald-500 transition flex items-center justify-center gap-2 disabled:opacity-50 mt-2"
              >
                {loadingReg && <Loader2 className="h-4 w-4 animate-spin" />}
                Registrarse
              </button>
            </form>
          </div>
        </div>
      )}

      {/* Modal de Iniciar Sesión */}
      {mostrarModalLogin && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
          <div className="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-xl relative">
            <button 
              onClick={() => setMostrarModalLogin(false)}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-700 font-bold"
            >
              ✕
            </button>
            <div className="text-center mb-4">
              <h3 className="text-lg font-bold text-slate-900">Iniciar Sesión</h3>
              <p className="text-xs text-slate-500">Ingresa tus credenciales de acceso</p>
            </div>

            {mensajeLog && (
              <div className={`mb-3 p-2.5 rounded-xl text-xs font-medium ${mensajeLog.tipo === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200'}`}>
                {mensajeLog.texto}
              </div>
            )}

            <form onSubmit={handleLogin} className="space-y-3">
              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Correo Electrónico</label>
                <input
                  type="email"
                  value={emailLog}
                  onChange={(e) => setEmailLog(e.target.value)}
                  placeholder="correo@ejemplo.com"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>
              <div>
                <label className="block text-[10px] font-semibold text-slate-700 uppercase mb-1">Contraseña</label>
                <input
                  type="password"
                  value={passwordLog}
                  onChange={(e) => setPasswordLog(e.target.value)}
                  placeholder="••••••••"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-emerald-600 focus:outline-none"
                />
              </div>
              <button
                type="submit"
                disabled={loadingLog}
                className="w-full rounded-xl bg-slate-900 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-slate-800 transition flex items-center justify-center gap-2 disabled:opacity-50 mt-2"
              >
                {loadingLog && <Loader2 className="h-4 w-4 animate-spin" />}
                Entrar al Sistema
              </button>
            </form>
          </div>
        </div>
      )}

      <footer className="border-t border-slate-200 bg-white py-6">
        <div className="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© 2026 Coconea. Arquitectura de Monorepo Modular.</p>
          <div className="flex gap-4">
            <span>Next.js</span>
            <span>·</span>
            <span>NestJS API</span>
            <span>·</span>
            <span>SQLite</span>
          </div>
        </div>
      </footer>
    </div>
  );
}