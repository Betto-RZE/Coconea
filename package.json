{
  "name": "coconea",
  "version": "0.1.0",
  "private": true,
  "description": "Coconea — Planifica tu alimentación, confirma y recibe.",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:flujo": "turbo run dev --filter=@coconea/api --filter=@coconea/customer --filter=@coconea/restaurant --filter=@coconea/delivery",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
